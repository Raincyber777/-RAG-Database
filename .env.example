# Django + Agent 统一配置：复制到本目录 .env。不要放到 Agent 或前端目录。
# 完成私有桶和新密钥配置后，将 local 改为 oss 并重启后端。
RAG_MEDIA_STORAGE=local
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 使用 STS 临时凭据时才填，必须同时提供对应的 AccessKey ID / Secret。
OSS_SECURITY_TOKEN=
OSS_PREFIX=classroom
OSS_URL_EXPIRE_SECONDS=900
OSS_CONNECT_TIMEOUT=30

# Agent（模型密钥、Tavily 与工具参数）
DASHSCOPE_API_KEY=
TAVILY_API_KEY=
AGENT_SEARCH_PROVIDER=tavily
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_SEARCH_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
AGENT_CHAT_MODEL=qwen-plus
AGENT_FAST_MODEL=qwen-flash
AGENT_VISION_MODEL=qwen3-vl-plus
AGENT_TIMEOUT=30
AGENT_ENABLE_SEARCH=true
DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
AGENT_ASR_MODEL=paraformer-v2
AGENT_EMBEDDING_MODEL=text-embedding-v4
AGENT_EMBEDDING_DIMENSIONS=1024
# Optional; pass explicitly to open_agent(postgres_uri=...).
POSTGRES_URI=

AGENT_ENABLED=1
AGENT_TENANT_ID=classroom
AGENT_MAX_MODEL_CALLS=8
