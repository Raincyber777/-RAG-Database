# ==============================================================
# 智学纪要 —— 环境变量模板（变量名与代码一一对应）
# 使用方法：复制为 .env（本地开发可用 python-dotenv 自动加载），
# 生产环境写入部署环境（如 /etc/rag-backend.env）。
# 严禁将填入真实密钥的 .env 提交到任何公开仓库。
# ==============================================================

# ---------- 1. Django 基础 ----------
DJANGO_DEBUG=True                        # 生产必须 False
RAG_DJANGO_SECRET_KEY=                   # 生产必填正式密钥（代码中的回退值仅限本地开发）
RAG_ALLOWED_HOSTS=                       # 逗号分隔，如 39.96.61.195,example.com
RAG_CSRF_ORIGINS=                        # 逗号分隔，前端站点地址（HTTPS 部署时需要）

# ---------- 2. 数据库（PostgreSQL）----------
RAG_DB_NAME=rag_db
RAG_DB_USER=postgres
RAG_DB_PASSWORD=                         # 生产必填；本地开发请改掉代码回退值对应的口令
RAG_DB_HOST=localhost
RAG_DB_PORT=5432

# ---------- 3. AI 服务（阿里云百炼 DashScope）----------
DASHSCOPE_API_KEY=                       # 语音转写 / 图像理解 / 语言模型 / 向量统一使用
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_SEARCH_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation

# ---------- 4. 联网检索（Tavily，可留空关闭联网）----------
TAVILY_API_KEY=

# ---------- 5. Agent 运行时（qa/agent 桥接，默认值即可跑通）----------
AGENT_ENABLED=1
AGENT_TENANT_ID=classroom
AGENT_MAX_MODEL_CALLS=8
AGENT_CHAT_MODEL=qwen-plus               # 主模型
AGENT_FAST_MODEL=qwen-flash              # 追问/轻量模型（限流兜底）
AGENT_ASR_MODEL=paraformer-v2            # 语音转写（长音频文件转写，带时间戳）
AGENT_VISION_MODEL=qwen3-vl-plus         # 板书/PPT 图像理解
AGENT_EMBEDDING_MODEL=text-embedding-v4  # 片段向量化
AGENT_EMBEDDING_DIMENSIONS=1024
AGENT_ENABLE_SEARCH=true
AGENT_SEARCH_PROVIDER=tavily
AGENT_TIMEOUT=30
POSTGRES_URI=                            # 可选；显式传给 open_agent(postgres_uri=...) 用

# ---------- 6. 媒体存储 ----------
RAG_MEDIA_STORAGE=local                  # local（本地 media/）或 oss（阿里云 OSS）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=                      # 使用 STS 临时凭据时填写，须同时提供对应 AK/SK
OSS_BUCKET=
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_PREFIX=classroom
OSS_URL_EXPIRE_SECONDS=900               # 签名 URL 有效期（秒）
OSS_CONNECT_TIMEOUT=30

# ---------- 7. 邮件（注册 / 换绑验证码，QQ 邮箱 SMTP 示例）----------
RAG_EMAIL_HOST=smtp.qq.com
RAG_EMAIL_PORT=465
RAG_EMAIL_SSL=True
RAG_EMAIL_USER=                          # 发信邮箱
RAG_EMAIL_PASSWORD=                      # 邮箱 SMTP 授权码（不是登录密码）
RAG_EMAIL_FROM=                          # 发件人显示地址

# ---------- 8. 短信验证码（阿里云 Dysmsapi，可选）----------
RAG_SMS_ACCESS_KEY_ID=
RAG_SMS_ACCESS_KEY_SECRET=
RAG_SMS_SIGN_NAME=
RAG_SMS_TEMPLATE_CODE=
